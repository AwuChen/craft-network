# LLM provider: openai (default) or anthropic
REACT_APP_LLM_PROVIDER=openai

# OpenAI
REACT_APP_OPENAI_API_KEY=sk-...
REACT_APP_OPENAI_MODEL=gpt-4o

# Anthropic (used when REACT_APP_LLM_PROVIDER=anthropic)
REACT_APP_ANTHROPIC_API_KEY=sk-ant-...
REACT_APP_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional Neo4j overrides (defaults are in src/index.js)
# REACT_APP_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# REACT_APP_NEO4J_USER=neo4j
# REACT_APP_NEO4J_PASSWORD=your-password

# Keep Neo4j Aura awake while the app is open (default: 30 minutes)
# REACT_APP_NEO4J_KEEPALIVE_MS=1800000
