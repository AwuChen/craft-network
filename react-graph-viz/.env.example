# ── Local development (.env.local — never commit) ──

REACT_APP_LLM_PROVIDER=openai
REACT_APP_OPENAI_API_KEY=sk-...
REACT_APP_OPENAI_MODEL=gpt-4o-mini

# Optional: test against local Render proxy while developing
# REACT_APP_LLM_PROXY_URL=http://localhost:3001/api/generate-cypher

# ── Production: Render proxy + GitHub Pages ──
#
# Step 1 — Deploy proxy on Render (one time)
#   • https://dashboard.render.com → New + → Blueprint
#   • Connect github.com/AwuChen/craft-network
#   • Render reads render.yaml automatically
#   • When prompted, set OPENAI_API_KEY
#   • Wait for deploy → copy URL, e.g. https://craft-network-llm.onrender.com
#   • Test: https://YOUR-APP.onrender.com/api/health
#
# Step 2 — GitHub Actions variable (not a Secret — it's just a URL)
#   • github.com/AwuChen/craft-network → Settings → Secrets and variables → Actions → Variables
#   • Name:  REACT_APP_LLM_PROXY_URL
#   • Value: https://YOUR-APP.onrender.com/api/generate-cypher
#
# Step 3 — Redeploy GitHub Pages
#   • Actions → "Deploy Craft Network to GitHub Pages" → Run workflow
#
# Local dev: uses .env.local keys directly (leave REACT_APP_LLM_PROXY_URL unset).
