# ── Local development (.env.local — never commit) ──

REACT_APP_LLM_PROVIDER=openai
REACT_APP_OPENAI_API_KEY=sk-...
REACT_APP_OPENAI_MODEL=gpt-4o-mini
REACT_APP_ANTHROPIC_API_KEY=sk-ant-...
REACT_APP_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional Neo4j overrides
# REACT_APP_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# REACT_APP_NEO4J_USER=neo4j
# REACT_APP_NEO4J_PASSWORD=your-password

# ── Production (GitHub Pages + Vercel proxy) ──
# API keys must NOT be baked into the GitHub Pages bundle.
#
# Vercel setup (one time):
#   1. vercel.com → Import AwuChen/craft-network
#   2. Root Directory: react-graph-viz
#   3. Framework Preset: Other  (vercel.json disables CRA auto-build)
#   4. Environment Variables: OPENAI_API_KEY = sk-...
#   5. Deploy, then test GET /api/health
#
# GitHub Actions variable (Settings → Actions → Variables):
#   REACT_APP_LLM_PROXY_URL = https://YOUR-PROJECT.vercel.app/api/generate-cypher
#
# Neo4j Keep-Alive secrets: NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD
