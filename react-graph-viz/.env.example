# ── Local development ──
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# LLM provider: openai (default) or anthropic
REACT_APP_LLM_PROVIDER=openai

REACT_APP_OPENAI_API_KEY=sk-...
REACT_APP_OPENAI_MODEL=gpt-4o-mini

REACT_APP_ANTHROPIC_API_KEY=sk-ant-...
REACT_APP_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional Neo4j overrides (defaults are in src/index.js)
# REACT_APP_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# REACT_APP_NEO4J_USER=neo4j
# REACT_APP_NEO4J_PASSWORD=your-password

# Keep Neo4j Aura awake while the app is open (default: 30 minutes)
# REACT_APP_NEO4J_KEEPALIVE_MS=1800000

# ── GitHub Pages deploy (GitHub repo Secrets) ──
# Settings → Secrets and variables → Actions → New repository secret
#
# Required for LLM search on the live site:
#   REACT_APP_OPENAI_API_KEY       your OpenAI key
#
# Optional:
#   REACT_APP_LLM_PROVIDER         openai | anthropic  (default: openai)
#   REACT_APP_ANTHROPIC_API_KEY    only if using anthropic
#
# Already used by Neo4j Keep-Alive workflow (reuse same values):
#   NEO4J_URI
#   NEO4J_USER
#   NEO4J_PASSWORD
#
# Deploy workflow: Actions → "Deploy Craft Network to GitHub Pages"
# Runs automatically on push to 0818-CraftNetworkUpdate or master
# when react-graph-viz/ changes, or trigger manually via Run workflow.
